# All variables are optional. Without them FlowDesk runs in demo mode with seeded data.

# Public site URL used for metadata, sitemap and Open Graph images
NEXT_PUBLIC_SITE_URL=

# Supabase (Auth, Postgres, Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the seed script (npm run db:seed)
DATABASE_URL=
SEED_OWNER_EMAIL=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
